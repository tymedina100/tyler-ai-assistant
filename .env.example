OPENAI_API_KEY=your-openai-key-here

# Optional: web search.
TAVILY_API_KEY=your-tavily-key-here

# Optional: single Telegram bot.
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
TELEGRAM_ALLOWED_USER_IDS=your-telegram-user-id-here

# Optional: multi-bot Telegram group.
TELEGRAM_MANAGER_BOT_TOKEN=your-manager-bot-token-here
TELEGRAM_CODE_BOT_TOKEN=your-code-bot-token-here
TELEGRAM_RESEARCH_BOT_TOKEN=your-research-bot-token-here
TELEGRAM_WEATHER_BOT_TOKEN=your-weather-bot-token-here
TELEGRAM_GROUP_CHAT_ID=your-telegram-group-chat-id-here

# Optional: external specialists.
OPENWEATHER_API_KEY=your-openweathermap-key-here
TODOIST_API_TOKEN=your-todoist-api-token-here

# Optional: proactive scheduling.
HOME_LOCATION=New York
BRIEFING_TIME=08:00
TIMEZONE=America/New_York
EVENT_ALERT_MINUTES=15

# Optional: mirror files or propose code changes through GitHub.
GITHUB_TOKEN=your-github-personal-access-token
GITHUB_REPO=your-username/your-files-repo
GITHUB_BRANCH=main
GITHUB_CODE_REPO=your-username/your-project-repo
GITHUB_CODE_BASE=main

# Optional: Google Calendar/Gmail deploy secret.
# Run python google_auth.py locally first, then copy token.json contents here.
GOOGLE_TOKEN_JSON=
