OPENAI_API_KEY=your-openai-key-here

# Optional: web search.
TAVILY_API_KEY=your-tavily-key-here

# Optional: single Telegram bot.
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
TELEGRAM_ALLOWED_USER_IDS=your-telegram-user-id-here

# Optional: multi-bot Telegram group. You only need a token for each agent whose
# key is listed in BOT_KEYS in group_bot.py - add the rest as you create the bots.
# Migrating from the pre-reorg roster? The old news/weather/tasks bots are being
# repurposed: in BotFather use /setname to retitle each bot (display name only -
# the @username is fixed at creation), then copy the old token value into the
# matching new var (news -> marketing, weather -> editor, tasks -> finance) and
# delete the old var.
TELEGRAM_MANAGER_BOT_TOKEN=your-manager-bot-token-here
TELEGRAM_CODE_BOT_TOKEN=your-code-bot-token-here
TELEGRAM_RESEARCH_BOT_TOKEN=your-research-bot-token-here
TELEGRAM_WRITE_BOT_TOKEN=your-write-bot-token-here
TELEGRAM_TASK_BOT_TOKEN=your-task-bot-token-here
TELEGRAM_MARKETING_BOT_TOKEN=your-marketing-bot-token-here
TELEGRAM_EDITOR_BOT_TOKEN=your-editor-bot-token-here
TELEGRAM_FINANCE_BOT_TOKEN=your-finance-bot-token-here
TELEGRAM_CALENDAR_BOT_TOKEN=your-calendar-bot-token-here
TELEGRAM_GMAIL_BOT_TOKEN=your-gmail-bot-token-here
# Optional bots: enabled only if their token is set (never required). Calendar
# (Cadence), Gmail (Piper), Linear, and the general all-rounder (Robin).
TELEGRAM_LINEAR_BOT_TOKEN=your-linear-bot-token-here
TELEGRAM_GENERAL_BOT_TOKEN=your-general-bot-token-here
TELEGRAM_GROUP_CHAT_ID=your-telegram-group-chat-id-here

# Virtual Office desktop connection. Set OFFICE_API_TOKEN to a long random secret in
# Railway; the Telegram worker will expose its read-only office-state API on $PORT.
# Set OFFICE_API_URL only on the desktop computer, to the Railway public service URL.
OFFICE_API_TOKEN=replace-with-a-long-random-secret
OFFICE_API_URL=https://your-railway-service.up.railway.app

# Optional: external specialists.
OPENWEATHER_API_KEY=your-openweathermap-key-here
TODOIST_API_TOKEN=your-todoist-api-token-here

# Optional: proactive scheduling.
HOME_LOCATION=New York
BRIEFING_TIME=08:00
DAILY_REPORT_TIME=18:00
TIMEZONE=America/New_York
EVENT_ALERT_MINUTES=15

# Optional: mirror files or propose code changes through GitHub.
GITHUB_TOKEN=your-github-personal-access-token
GITHUB_REPO=your-username/your-files-repo
GITHUB_BRANCH=main
# Fallback code repo when NO project is selected (see projects.json + /project use).
# With an active project, the code tools target that project's repo instead.
GITHUB_CODE_REPO=your-username/your-project-repo
GITHUB_CODE_BASE=main

# Optional: Linear integration (project management). Reads are safe; issue
# creation only happens on explicit /linear commands or clear requests.
LINEAR_API_KEY=your-linear-api-key
LINEAR_TEAM_ID=your-default-linear-team-id
LINEAR_WORKSPACE_ID=optional-workspace-id
LINEAR_DEFAULT_PROJECT_ID=optional-default-project-id
# Optional per-project Linear project ids: LINEAR_PROJECT_ID_<KEY>, e.g.
# LINEAR_PROJECT_ID_VANTAGE=... / LINEAR_PROJECT_ID_CARD_TRACKER=...

# Optional: Google Calendar/Gmail deploy secret.
# Run python google_auth.py locally first, then copy token.json contents here.
GOOGLE_TOKEN_JSON=

# Optional: Company Mode revenue tracking (/revenue). Read-only sales from Gumroad.
# Get it at Gumroad -> Settings -> Advanced -> Applications -> generate access token.
GUMROAD_ACCESS_TOKEN=your-gumroad-access-token

# Optional: Vercel deploys (deploy_site). Lets Patch/Sway put a landing page live.
# The Vercel project must be linked to its GitHub repo. Create a token at
# Vercel -> Settings -> Tokens. VERCEL_TEAM_ID is only needed for team-scoped projects.
VERCEL_TOKEN=your-vercel-token
VERCEL_TEAM_ID=optional-vercel-team-id

# Optional: Railway infra access (railway_* tools). Lets Patch inspect services,
# env-var names, and deploy status, and - gated behind /confirm - set a variable or
# trigger a redeploy. Create an account token at Railway -> Account Settings -> Tokens.
# Note: reading a specific variable value can expose a secret to the assistant.
RAILWAY_TOKEN=your-railway-token
