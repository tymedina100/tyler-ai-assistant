OPENAI_API_KEY=your-openai-key-here

# Optional: persistent state root. Leave blank for the repository directory locally.
# On Railway, mount one volume and set this to its mount path (for example /app/data).
# If unset, the app also honors Railway's RAILWAY_VOLUME_MOUNT_PATH fallback.
DATA_DIR=

# Optional: web search.
TAVILY_API_KEY=your-tavily-key-here

# Optional: single Telegram bot.
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
TELEGRAM_ALLOWED_USER_IDS=your-telegram-user-id-here

# Optional: multi-bot Telegram group. You only need a token for each agent whose
# key is listed in BOT_KEYS in group_bot.py - add the rest as you create the bots.
# Migrating from the pre-reorg roster? The old news/weather/tasks bots are being
# repurposed: in BotFather use /setname to retitle each bot (display name only -
# the @username is fixed at creation), then copy the old token value into the
# matching new var (news -> marketing, weather -> editor, tasks -> finance) and
# delete the old var.
TELEGRAM_MANAGER_BOT_TOKEN=your-manager-bot-token-here
TELEGRAM_CODE_BOT_TOKEN=your-code-bot-token-here
TELEGRAM_RESEARCH_BOT_TOKEN=your-research-bot-token-here
TELEGRAM_WRITE_BOT_TOKEN=your-write-bot-token-here
TELEGRAM_TASK_BOT_TOKEN=your-task-bot-token-here
TELEGRAM_MARKETING_BOT_TOKEN=your-marketing-bot-token-here
TELEGRAM_EDITOR_BOT_TOKEN=your-editor-bot-token-here
TELEGRAM_FINANCE_BOT_TOKEN=your-finance-bot-token-here
# Optional bots: enabled only if their token is set (never required). Calendar
# (Cadence), Gmail (Piper), Linear, the general all-rounder (Robin), Sales (Dash),
# and Analytics (Vega).
TELEGRAM_CALENDAR_BOT_TOKEN=your-calendar-bot-token-here
TELEGRAM_GMAIL_BOT_TOKEN=your-gmail-bot-token-here
TELEGRAM_LINEAR_BOT_TOKEN=your-linear-bot-token-here
TELEGRAM_GENERAL_BOT_TOKEN=your-general-bot-token-here
TELEGRAM_SALES_BOT_TOKEN=your-sales-bot-token-here
TELEGRAM_ANALYTICS_BOT_TOKEN=your-analytics-bot-token-here
TELEGRAM_GROUP_CHAT_ID=your-telegram-group-chat-id-here

# Virtual Office desktop connection. Set OFFICE_API_TOKEN to a long random secret in
# Railway; the Telegram worker will expose its read-only office-state API on $PORT.
# Set OFFICE_API_URL only on the desktop computer, to the Railway public service URL.
OFFICE_API_TOKEN=replace-with-a-long-random-secret
OFFICE_API_URL=https://your-railway-service.up.railway.app

# Optional: external specialists.
OPENWEATHER_API_KEY=your-openweathermap-key-here
TODOIST_API_TOKEN=your-todoist-api-token-here

# Optional: proactive scheduling.
HOME_LOCATION=New York
BRIEFING_TIME=08:00
DAILY_REPORT_TIME=18:00
TIMEZONE=America/New_York
EVENT_ALERT_MINUTES=15

# Optional: safe autonomous daily-session control plane. Scheduled autonomy is OFF and
# dry-run is ON by default. Keep these defaults until local + Telegram dry-runs look
# correct. A live session works sequentially on useful, affordable roadmap items; it
# never spends merely to reach an exact dollar amount.
AUTONOMY_ENABLED=false
AUTONOMY_DRY_RUN=true
AUTONOMY_SCHEDULE_TIME=08:00
AUTONOMY_SCHEDULE_DAYS=mon-fri
AUTONOMY_TIMEZONE=America/Phoenix
# Shared Company Mode budget-day boundary. Keep this aligned with the autonomous
# scheduler unless you intentionally want spend to roll over on a different date.
BUDGET_TIMEZONE=America/Phoenix
AUTONOMY_DAILY_BUDGET_USD=5.00
AUTONOMY_EMERGENCY_RESERVE_USD=0.25
# Hard session ceilings. Each roadmap item may be selected at most once per session;
# a task-local blocker does not prevent unrelated ready work from continuing.
AUTONOMY_MAX_TASKS_PER_RUN=10
AUTONOMY_MAX_SESSION_MINUTES=120
# A route estimate covers one model response; live worker/reviewer reservations use the
# greater of (estimate x multiplier) or the minimum to cover a bounded tool loop.
AUTONOMY_COST_ESTIMATE_MULTIPLIER=4.0
AUTONOMY_MIN_TASK_RESERVATION_USD=0.05
# Provider-side output ceiling for each metered autonomous model request. The runtime
# lowers this further when the task's unspent reservation cannot afford the full cap.
AUTONOMY_MAX_OUTPUT_TOKENS_PER_CALL=3000
# Autonomous tool results are truncated before being appended to the next model
# request. Ordinary interactive chats keep their existing behavior.
AUTONOMY_MAX_TOOL_RESULT_CHARS=12000
# Show real assignment, handoff, review, and bounded-retry transitions in Telegram.
# These messages are deterministic workflow events and make no extra model calls.
AUTONOMY_TEAM_CHAT_ENABLED=true
AUTONOMY_TEAM_CHAT_MAX_CHARS=900
# After roadmap work is exhausted, Lumen may make one bounded batch of up to three
# proposed ideas. Ideas enter the backlog only; they are never built automatically.
AUTONOMY_MAX_IDEAS_PER_RUN=3
AUTONOMY_IDEA_BACKLOG_LIMIT=50
AUTONOMY_MAX_EXECUTION_ATTEMPTS=2
# Monitoring ceiling per Company Mode task attempt. Python worker threads are awaited
# to completion for ledger safety; a late attempt is stopped from retrying/escalated.
AUTONOMY_TASK_TIMEOUT_SECONDS=900
AUTONOMY_STALE_RUN_MINUTES=180
AUTONOMY_MAX_AUTHORIZATION=propose
AUTONOMY_LOCK_TIMEOUT_SECONDS=0
# Optional overrides. Blank AUTONOMY_DATA_DIR falls back to DATA_DIR, then Railway's
# volume mount, then the repo. Catalog prices are operator-maintained estimates.
AUTONOMY_DATA_DIR=
AUTONOMY_ROADMAP_FILE=config/autonomous-roadmap.json
# Repository-owned, owner-confirmed project packs. A pack is previewed and revision-bound
# before its goal/items are appended to persistent state; editing this directory alone
# never changes Railway state or starts paid work.
AUTONOMY_PROJECT_PACK_DIR=config/autonomous-projects
MODEL_CATALOG_FILE=config/model-catalog.json

# Company Mode budget/review controls used by live autonomous execution. The reserve
# value seeds new/legacy state; an existing company_state.json retains its stored value.
COMPANY_EMERGENCY_RESERVE_USD=0.25
# Default pre-call hold for metered group chat when no task-specific estimate is supplied.
ADHOC_RESERVATION_USD=0.10
MAX_REVISION_ROUNDS=2
MAX_EXECUTION_ATTEMPTS=3
# Maximum non-file result copied into the persisted run report and Telegram delivery.
MAX_TASK_RESULT_CHARS=5000
# Larger bounded internal result/feedback context used for evidence-based review.
MAX_TASK_STORED_RESULT_CHARS=20000
MAX_REVIEW_FEEDBACK_CHARS=12000
MAX_EDITOR_FEEDBACK_HISTORY=10

# Optional: mirror files or propose code changes through GitHub.
GITHUB_TOKEN=your-github-personal-access-token
GITHUB_REPO=your-username/your-files-repo
GITHUB_BRANCH=main
# Fallback code repo when NO project is selected (see projects.json + /project use).
# With an active project, the code tools target that project's repo instead.
GITHUB_CODE_REPO=your-username/your-project-repo
GITHUB_CODE_BASE=main

# Optional: Linear integration (project management). Reads are safe; issue
# creation only happens on explicit /linear commands or clear requests.
LINEAR_API_KEY=your-linear-api-key
LINEAR_TEAM_ID=your-default-linear-team-id
LINEAR_WORKSPACE_ID=optional-workspace-id
LINEAR_DEFAULT_PROJECT_ID=optional-default-project-id
# Optional per-project Linear project ids: LINEAR_PROJECT_ID_<KEY>, e.g.
# LINEAR_PROJECT_ID_VANTAGE=... / LINEAR_PROJECT_ID_CARD_TRACKER=...

# Optional: Google Calendar/Gmail deploy secret.
# Run python google_auth.py locally first, then copy token.json contents here.
GOOGLE_TOKEN_JSON=

# Optional: Company Mode revenue tracking (/revenue). Read-only sales from Gumroad.
# Get it at Gumroad -> Settings -> Advanced -> Applications -> generate access token.
GUMROAD_ACCESS_TOKEN=your-gumroad-access-token

# Optional: Vercel deploys (deploy_site). Lets Patch/Sway put a landing page live.
# The Vercel project must be linked to its GitHub repo. Create a token at
# Vercel -> Settings -> Tokens. VERCEL_TEAM_ID is only needed for team-scoped projects.
VERCEL_TOKEN=your-vercel-token
VERCEL_TEAM_ID=optional-vercel-team-id

# Optional: Railway infra access (railway_* tools). Lets Patch inspect services,
# env-var names, and deploy status, and - gated behind /confirm - set a variable or
# trigger a redeploy. Create an account token at Railway -> Account Settings -> Tokens.
# Note: reading a specific variable value can expose a secret to the assistant.
RAILWAY_TOKEN=your-railway-token
